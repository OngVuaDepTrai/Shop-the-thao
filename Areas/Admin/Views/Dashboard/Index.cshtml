
@{
    ViewBag.Title = "Dashboard";
}

<div class="mb-4">
    <h4 class="fw-bold">Tổng quan hệ thống</h4>
    <p class="text-secondary mb-0">
        Chào mừng bạn đến với trang quản trị ShopTheThao.
    </p>
</div>

<div class="row g-3">

    <div class="col-12 col-md-6 col-xl-3">
        <div class="p-4 rounded-3"
             style="background: #1F2937; border: 1px solid #374151;">

            <div class="d-flex justify-content-between">
                <span class="text-secondary">Tổng đơn hàng</span>
                <i class="bi bi-receipt"
                   style="color: #F97316; font-size: 22px;"></i>
            </div>

            <h3 class="fw-bold mt-3">0</h3>
            <small class="text-secondary">Dữ liệu đang chờ kết nối</small>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="p-4 rounded-3"
             style="background: #1F2937; border: 1px solid #374151;">

            <div class="d-flex justify-content-between">
                <span class="text-secondary">Sản phẩm</span>
                <i class="bi bi-box-seam"
                   style="color: #FACC15; font-size: 22px;"></i>
            </div>

            <h3 class="fw-bold mt-3">0</h3>
            <small class="text-secondary">Dữ liệu đang chờ kết nối</small>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="p-4 rounded-3"
             style="background: #1F2937; border: 1px solid #374151;">

            <div class="d-flex justify-content-between">
                <span class="text-secondary">Khách hàng</span>
                <i class="bi bi-people"
                   style="color: #F97316; font-size: 22px;"></i>
            </div>

            <h3 class="fw-bold mt-3">0</h3>
            <small class="text-secondary">Dữ liệu đang chờ kết nối</small>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="p-4 rounded-3"
             style="background: #1F2937; border: 1px solid #374151;">

            <div class="d-flex justify-content-between">
                <span class="text-secondary">Doanh thu</span>
                <i class="bi bi-currency-dollar"
                   style="color: #FACC15; font-size: 22px;"></i>
            </div>

            <h3 class="fw-bold mt-3">0 ₫</h3>
            <small class="text-secondary">Dữ liệu đang chờ kết nối</small>
        </div>
    </div>

</div>

<div class="mt-4 p-4 rounded-3"
     style="background: #1F2937; border: 1px solid #374151;">

    <h5 class="fw-bold mb-2">Admin Layout đã hoạt động</h5>

    <p class="text-secondary mb-0">
        Bạn đang sử dụng giao diện quản trị mới.
        Các chức năng thống kê và quản lý sẽ được triển khai ở những giai đoạn tiếp theo.
    </p>

</div>
