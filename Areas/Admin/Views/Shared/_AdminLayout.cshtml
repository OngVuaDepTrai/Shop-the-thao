
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - ShopTheThao Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/css/admin.css")"
          rel="stylesheet" />
</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"] as string;
        var currentAction = ViewContext.RouteData.Values["action"] as string;
    }

    <div class="admin-wrapper">

        <!-- Sidebar overlay trên mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- SIDEBAR -->
        <aside class="admin-sidebar" id="adminSidebar">

            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>

                <div class="brand-text">
                    <h5>SPORT<span>ZONE</span></h5>
                    <small>ADMINISTRATION</small>
                </div>

                <button class="sidebar-close d-lg-none"
                        id="sidebarClose"
                        type="button">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="sidebar-content">

                <div class="sidebar-section-title">
                    TỔNG QUAN
                </div>

                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">

                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <div class="sidebar-section-title">
                    QUẢN LÝ CỬA HÀNG
                </div>

                <a href="@Url.Action("Index", "Orders", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Orders" ? "active" : "")">

                    <i class="bi bi-receipt"></i>
                    <span>Đơn hàng</span>
                </a>

                <a href="@Url.Action("Index", "Products", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Products" ? "active" : "")">

                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>

                <a href="@Url.Action("Index", "Categories", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Categories" ? "active" : "")">

                    <i class="bi bi-tags"></i>
                    <span>Danh mục</span>
                </a>

                <a href="@Url.Action("Index", "Brands", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Brands" ? "active" : "")">

                    <i class="bi bi-award"></i>
                    <span>Thương hiệu</span>
                </a>

                <div class="sidebar-section-title">
                    KHÁCH HÀNG
                </div>

                <a href="@Url.Action("Index", "Users", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Users" ? "active" : "")">

                    <i class="bi bi-people"></i>
                    <span>Người dùng</span>
                </a>

                <a href="@Url.Action("Index", "Reviews", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Reviews" ? "active" : "")">

                    <i class="bi bi-star"></i>
                    <span>Đánh giá</span>
                </a>

                <a href="@Url.Action("Index", "Contacts", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Contacts" ? "active" : "")">

                    <i class="bi bi-chat-left-text"></i>
                    <span>Liên hệ</span>
                </a>

                <div class="sidebar-section-title">
                    THỐNG KÊ
                </div>

                <a href="@Url.Action("Index", "Reports", new { area = "Admin" })"
                   class="sidebar-link @(currentController == "Reports" ? "active" : "")">

                    <i class="bi bi-bar-chart-line"></i>
                    <span>Báo cáo</span>
                </a>

            </div>

            <div class="sidebar-footer">
                <div class="sidebar-footer-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <div>
                    <strong>Admin Panel</strong>
                    <small>ShopTheThao Management</small>
                </div>
            </div>

        </aside>

        <!-- MAIN AREA -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div class="topbar-left">

                    <button class="sidebar-toggle"
                            id="sidebarToggle"
                            type="button"
                            aria-label="Mở menu">

                        <i class="bi bi-list"></i>
                    </button>

                    <div class="topbar-heading">
                        <h5>@ViewBag.Title</h5>
                        <small>Quản lý hệ thống ShopTheThao</small>
                    </div>

                </div>

                <div class="topbar-right">

                    <div class="admin-profile">
                        <div class="profile-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="profile-info">
                            <strong>Administrator</strong>
                            <small>Quản trị viên</small>
                        </div>
                    </div>

                    <a href="@Url.Action("Logout", "Account", new { area = "" })"
                       class="logout-button"
                       title="Đăng xuất">

                        <i class="bi bi-box-arrow-right"></i>
                    </a>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <main class="admin-content">

                @RenderBody()

            </main>

            <!-- FOOTER -->
            <footer class="admin-footer">
                <span>© @DateTime.Now.Year ShopTheThao.</span>
                <span>Admin Management System</span>
            </footer>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="@Url.Content("~/Scripts/admin.js")"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
