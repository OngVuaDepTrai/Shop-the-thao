@using System.Linq
@model IEnumerable<ShopTheThao.Models.Brand>

@{
    ViewBag.Title = "Thương hiệu";

    var brands = Model.ToList();
}

<div class="admin-page-head">

    <div>
        <h4>Thương hiệu</h4>
        <p class="subtitle mb-0">Quản lý các thương hiệu sản phẩm của cửa hàng.</p>
    </div>

    <a href="@Url.Action("Create", "Brands", new { area = "Admin" })"
       class="btn-admin btn-admin-primary">

        <i class="bi bi-plus-lg"></i>
        <span>Thêm thương hiệu</span>
    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="admin-alert admin-alert-success">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="admin-alert admin-alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="admin-card">

    @if (brands.Count > 0)
    {
        <div class="admin-table-wrap">
            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Thương hiệu</th>
                        <th>Sản phẩm</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in brands)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                                    {
                                        <img class="admin-thumb"
                                             src="@item.LogoUrl"
                                             alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="admin-thumb-placeholder">
                                            <i class="bi bi-award"></i>
                                        </div>
                                    }

                                    <div>
                                        <strong>@item.Name</strong>
                                        <small class="d-block text-secondary">Mã #@item.Id</small>
                                    </div>

                                </div>
                            </td>

                            <td>
                                <span class="admin-count">@item.Products.Count sản phẩm</span>
                            </td>

                            <td>
                                <div class="admin-actions">

                                    <a href="@Url.Action("Edit", "Brands", new { area = "Admin", id = item.Id })"
                                       class="btn-admin btn-admin-sm btn-admin-outline"
                                       title="Sửa thương hiệu">

                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    @using (Html.BeginForm("Delete", "Brands",
                                        new { area = "Admin", id = item.Id },
                                        FormMethod.Post,
                                        new { @class = "m-0", onsubmit = "return confirm('Bạn có chắc muốn xóa thương hiệu này?');" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-admin btn-admin-sm btn-admin-danger"
                                                title="Xóa thương hiệu">

                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="admin-empty">
            <i class="bi bi-award"></i>
            <strong>Chưa có thương hiệu nào</strong>
            <span>Bấm "Thêm thương hiệu" để tạo thương hiệu đầu tiên.</span>
        </div>
    }

</div>

<div class="admin-count mt-3">
    Tổng cộng @brands.Count thương hiệu
</div>
