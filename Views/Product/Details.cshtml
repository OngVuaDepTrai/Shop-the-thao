@model ShopTheThao.ViewModels.ProductDetailsViewModel
@{
    ViewBag.Title = Model.Product.Name;
    var vn = new System.Globalization.CultureInfo("vi-VN");
    var onSale = Model.Product.SalePrice.HasValue && Model.Product.SalePrice.Value < Model.Product.Price;
    var nowPrice = onSale ? Model.Product.SalePrice.Value : Model.Product.Price;
    var mainImg = Model.GalleryImages.Any() ? Model.GalleryImages.First() : "/Content/images/placeholder.jpg";
}

<div class="wrap py-4">
    <!-- Horizontal Editorial Breadcrumb -->
    <nav class="sport-breadcrumb" aria-label="breadcrumb">
        <ol>
            <li><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li><a href="@Url.Action("Index", "Product")">Bộ sưu tập</a></li>
            @if (Model.Product.Category != null)
            {
                <li><a href="@Url.Action("Index", "Product", new { CategoryId = Model.Product.CategoryId })">@Model.Product.Category.Name</a></li>
            }
            <li class="active text-truncate" style="max-width: 320px;">@Model.Product.Name</li>
        </ol>
    </nav>

    <!-- Main Product Layout (2 Columns) -->
    <div class="row g-4 g-lg-5 mb-5">
        <!-- Col Left: Studio Gallery Showcase -->
        <div class="col-lg-6">
            <div class="product-gallery-main">
                <img id="mainProductImage" src="@mainImg" alt="@Model.Product.Name" />
                @if (onSale)
                {
                    <span class="p-badge">Ưu đãi -@(100 - (int)(Model.Product.SalePrice.Value * 100 / Model.Product.Price))%</span>
                }
            </div>

            @if (Model.GalleryImages.Count > 1)
            {
                <div class="gallery-thumbs">
                    @for (int i = 0; i < Model.GalleryImages.Count; i++)
                    {
                        var imgUrl = Model.GalleryImages[i];
                        <div class="thumb-item @(i == 0 ? "active" : "")" data-img-src="@imgUrl">
                            <img src="@imgUrl" alt="Ảnh @(i + 1)" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Col Right: Product Info & Purchase Options -->
        <div class="col-lg-6">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="eyebrow mb-0">
                    @(Model.Product.Category != null ? Model.Product.Category.Name : "Thể thao")
                    @(Model.Product.Brand != null ? " • " + Model.Product.Brand.Name : "")
                </span>
                <span class="text-muted small">Mã SP: <strong class="text-dark">@(Model.Product.Code ?? "SP" + Model.Product.Id)</strong></span>
            </div>

            <h1 class="editorial-heading mb-3" style="font-size: clamp(1.85rem, 3vw, 2.5rem);">
                @Model.Product.Name
            </h1>

            <!-- Ratings & Sold Count -->
            <div class="d-flex align-items-center gap-3 mb-2 small">
                <div class="d-flex align-items-center gap-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Math.Round(Model.AverageRating) ? "bi-star-fill text-warning" : "bi-star text-muted opacity-50")"></i>
                    }
                    <span class="fw-semibold text-dark ms-1">@Model.AverageRating</span>
                </div>
                <span class="text-muted">•</span>
                <span class="text-muted">@Model.TotalReviews đánh giá</span>
                <span class="text-muted">•</span>
                <span class="text-muted">Đã bán @Model.Product.SoldCount</span>
            </div>

            <!-- Price Box -->
            <div class="detail-price-box">
                <div class="d-flex align-items-baseline flex-wrap">
                    <span class="detail-price-main">@nowPrice.ToString("N0", vn) ₫</span>
                    @if (onSale)
                    {
                        <span class="detail-price-old">@Model.Product.Price.ToString("N0", vn) ₫</span>
                        <span class="price-save-tag">Tiết kiệm @((Model.Product.Price - Model.Product.SalePrice.Value).ToString("N0", vn)) ₫</span>
                    }
                </div>
                <small class="text-muted d-block mt-1">Giá đã bao gồm VAT • Miễn phí vận chuyển cho đơn hàng từ 500.000₫</small>
            </div>

            <!-- Form Thêm Giỏ Hàng & Mua Hàng -->
            <form action="@Url.Action("Add", "Cart")" method="post" id="addToCartForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Product.Id" />
                <input type="hidden" name="size" id="selectedSize" value="@(Model.Sizes.FirstOrDefault() ?? "")" />
                <input type="hidden" name="color" id="selectedColor" value="@(Model.Colors.FirstOrDefault() ?? "")" />

                <!-- 1. Kích thước (Size) -->
                @if (Model.Sizes != null && Model.Sizes.Any())
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-uppercase" style="letter-spacing: 0.06em;">Kích cỡ (Size)</span>
                            <a href="#sizeGuideModal" data-bs-toggle="modal" class="small text-muted text-decoration-underline">Bảng quy đổi kích cỡ</a>
                        </div>
                        <div class="size-picker">
                            @for (int i = 0; i < Model.Sizes.Count; i++)
                            {
                                var s = Model.Sizes[i];
                                <div class="size-pill @(i == 0 ? "active" : "")" data-size="@s">
                                    @s
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- 2. Màu sắc -->
                @if (Model.Colors != null && Model.Colors.Any())
                {
                    <div class="mb-4">
                        <div class="small fw-semibold text-uppercase mb-2" style="letter-spacing: 0.06em;">Phối màu</div>
                        <div class="d-flex flex-wrap gap-2 color-picker">
                            @for (int i = 0; i < Model.Colors.Count; i++)
                            {
                                var c = Model.Colors[i];
                                <div class="color-pill @(i == 0 ? "active" : "")" data-color="@c">
                                    @c
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- 3. Số lượng -->
                <div class="mb-4">
                    <div class="small fw-semibold text-uppercase mb-2" style="letter-spacing: 0.06em;">Số lượng</div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="qty-control">
                            <button type="button" class="qty-btn qty-minus" aria-label="Giảm"><i class="bi bi-dash"></i></button>
                            <input type="number" name="quantity" class="qty-input" value="1" min="1" max="99" aria-label="Số lượng" />
                            <button type="button" class="qty-btn qty-plus" aria-label="Tăng"><i class="bi bi-plus"></i></button>
                        </div>
                        <span class="text-muted small">Sẵn sàng giao ngay</span>
                    </div>
                </div>

                <!-- Action CTA Buttons -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <button type="submit" class="btn-outline-orange flex-grow-1 py-3">
                        <i class="bi bi-bag-plus"></i>
                        <span>Thêm vào giỏ hàng</span>
                    </button>
                    <button type="submit" name="buyNow" value="true" class="btn-orange flex-grow-1 py-3">
                        <span>Mua ngay</span>
                        <i class="bi bi-arrow-up-right"></i>
                    </button>
                    <a href="@Url.Action("Add", "Wishlist", new { productId = Model.Product.Id })" class="action-icon-btn" style="width: 48px; height: 48px;" title="Lưu vào yêu thích" aria-label="Lưu vào yêu thích">
                        <i class="bi bi-heart"></i>
                    </a>
                </div>
            </form>

            <!-- Trust Commitments -->
            <div class="trust-badges-box">
                <div class="trust-item">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <b>Bảo chứng chính hãng 100%</b>
                        <small>Mỗi sản phẩm đều đi kèm hộp nguyên bản, tem kiểm định và phiếu bảo hành.</small>
                    </div>
                </div>
                <div class="trust-item">
                    <i class="bi bi-arrow-left-right"></i>
                    <div>
                        <b>Đổi size tận nơi trong 7 ngày</b>
                        <small>Hỗ trợ đổi kích cỡ nhanh chóng nếu phom giày hoặc trang phục chưa vừa vặn.</small>
                    </div>
                </div>
                <div class="trust-item">
                    <i class="bi bi-truck"></i>
                    <div>
                        <b>Vận chuyển tiêu chuẩn toàn quốc</b>
                        <small>Kiểm tra ngoại quan sản phẩm trước khi thanh toán khi nhận hàng.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Tabs: Description, Specs, Reviews -->
    <div class="bg-surface border rounded-3 p-4 p-lg-5 mb-5" style="border-color: var(--line-border) !important;">
        <ul class="nav nav-tabs sport-tabs" id="productTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">
                    Mô tả chi tiết
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button" role="tab">
                    Thông số &amp; Bảo quản
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                    Đánh giá (@Model.TotalReviews)
                </button>
            </li>
        </ul>

        <div class="tab-content pt-4" id="productTabsContent">
            <!-- Tab 1: Mô tả -->
            <div class="tab-pane fade show active" id="desc" role="tabpanel">
                <div style="max-width: 760px; line-height: 1.85; color: var(--text);">
                    @if (!string.IsNullOrEmpty(Model.Product.Description))
                    {
                        <p class="mb-0" style="white-space: pre-line;">@Model.Product.Description</p>
                    }
                    else
                    {
                        <p class="mb-0">Thiết kế thể thao hiệu năng cao từ SportHub, kết hợp chất liệu thoáng khí và cấu trúc nâng đỡ chuẩn xác cho từng chuyển động.</p>
                    }
                </div>
            </div>

            <!-- Tab 2: Thông số -->
            <div class="tab-pane fade" id="specs" role="tabpanel">
                <div class="row g-4">
                    <div class="col-md-6">
                        <table class="table table-bordered mb-0" style="border-color: var(--line-border);">
                            <tbody>
                                <tr><th class="bg-stone fw-semibold" style="width: 38%;">Mã định danh</th><td>@(Model.Product.Code ?? "SP" + Model.Product.Id)</td></tr>
                                <tr><th class="bg-stone fw-semibold">Thương hiệu</th><td>@(Model.Product.Brand != null ? Model.Product.Brand.Name : "SportHub")</td></tr>
                                <tr><th class="bg-stone fw-semibold">Bộ môn</th><td>@(Model.Product.Category != null ? Model.Product.Category.Name : "Thể thao")</td></tr>
                                <tr><th class="bg-stone fw-semibold">Quy cách</th><td>Fullbox nguyên tem chính hãng</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-2">Hướng dẫn bảo quản</h6>
                        <ul class="text-muted small mb-0" style="line-height: 1.8;">
                            <li>Vệ sinh bề mặt bằng khăn ẩm mềm hoặc dung dịch chuyên dụng.</li>
                            <li>Phơi nơi khô thoáng tự nhiên, tránh ánh nắng gắt trực tiếp.</li>
                            <li>Bảo quản nơi thoáng mát, sử dụng giấy giữ phom khi không sử dụng.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tab 3: Đánh giá -->
            <div class="tab-pane fade" id="reviews" role="tabpanel">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="p-4 bg-stone rounded-3 mb-4">
                        <h6 class="fw-semibold mb-3">Chia sẻ trải nghiệm của bạn</h6>
                        @using (Html.BeginForm("AddReview", "Product", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Product.Id" />
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small text-muted">Mức độ hài lòng</label>
                                    <select name="rating" class="form-select form-select-sm">
                                        <option value="5">5 sao — Tuyệt vời</option>
                                        <option value="4">4 sao — Rất tốt</option>
                                        <option value="3">3 sao — Hài lòng</option>
                                        <option value="2">2 sao — Tạm ổn</option>
                                        <option value="1">1 sao — Chưa đạt kỳ vọng</option>
                                    </select>
                                </div>
                                <div class="col-md-9">
                                    <label class="form-label small text-muted">Nhận xét thực tế</label>
                                    <input type="text" name="comment" class="form-control form-control-sm" placeholder="Chia sẻ cảm nhận về chất liệu, độ êm và phom dáng..." required />
                                </div>
                                <div class="col-12 text-end">
                                    <button type="submit" class="btn-orange py-2 px-4" style="font-size: 0.84rem;">Gửi đánh giá</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-orange mb-4">
                        <i class="bi bi-person-check"></i>
                        <span>Vui lòng <a href="@Url.Action("Login", "Account")" class="fw-semibold text-decoration-underline">đăng nhập</a> để gửi nhận xét về sản phẩm này.</span>
                    </div>
                }

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var r in Model.Reviews)
                        {
                            <div class="p-3 border rounded-3 bg-surface" style="border-color: var(--line-border) !important;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold">@(r.User != null ? r.User.FullName : "Khách hàng SportHub")</span>
                                    <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                                <div class="text-warning small mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star text-muted opacity-25")"></i>
                                    }
                                </div>
                                <p class="mb-0 small text-dark">@r.Comment</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted py-3 mb-0">Chưa có nhận xét nào. Hãy là người đầu tiên chia sẻ cảm nhận về thiết kế này.</p>
                }
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="mt-5">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="eyebrow">GỢI Ý CÙNG BỘ SƯU TẬP</span>
                    <h3 class="editorial-heading mb-0" style="font-size: 1.75rem;">Thiết kế đồng điệu</h3>
                </div>
                <a href="@Url.Action("Index", "Product", new { CategoryId = Model.Product.CategoryId })" class="small fw-semibold text-uppercase" style="letter-spacing: 0.1em;">
                    Xem toàn bộ <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                @foreach (var p in Model.RelatedProducts)
                {
                    <div class="col">
                        @Html.Partial("_ProductCard", p)
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Size Guide Modal -->
<div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-3 border-0">
            <div class="modal-header border-bottom">
                <h5 class="modal-title editorial-heading">Bảng Quy Đổi Kích Cỡ Tiêu Chuẩn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <h6 class="fw-semibold mb-2">1. Kích cỡ giày thể thao (VN / EU)</h6>
                <table class="table table-bordered text-center align-middle small mb-4">
                    <thead class="bg-stone"><tr><th>Size EU</th><th>39</th><th>40</th><th>41</th><th>42</th><th>43</th><th>44</th></tr></thead>
                    <tbody><tr><td>Chiều dài bàn chân (cm)</td><td>24.5</td><td>25.0</td><td>25.5</td><td>26.0</td><td>26.5</td><td>27.0</td></tr></tbody>
                </table>

                <h6 class="fw-semibold mb-2">2. Kích cỡ trang phục thể thao</h6>
                <table class="table table-bordered text-center align-middle small mb-0">
                    <thead class="bg-stone"><tr><th>Size</th><th>S</th><th>M</th><th>L</th><th>XL</th><th>XXL</th></tr></thead>
                    <tbody>
                        <tr><td>Chiều cao (cm)</td><td>155 – 165</td><td>165 – 170</td><td>170 – 175</td><td>175 – 180</td><td>180 – 188</td></tr>
                        <tr><td>Cân nặng (kg)</td><td>48 – 56</td><td>57 – 65</td><td>66 – 74</td><td>75 – 82</td><td>83 – 90</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
