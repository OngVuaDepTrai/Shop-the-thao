@model ShopTheThao.ViewModels.LoginViewModel
@{ ViewBag.Title = "Đăng nhập"; Layout = "~/Views/Shared/_AuthLayout.cshtml"; }

<div class="auth-card">
    <h2>Chào mừng trở lại</h2>
    <p class="sub">Đăng nhập để tiếp tục mua sắm</p>

    @if (TempData["Success"] != null)
    {<div class="alert alert-orange">@TempData["Success"]</div>}

    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)

        <div class="input-ico">
            <i class="bi bi-envelope"></i>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>
        <div class="input-ico">
            <i class="bi bi-lock"></i>
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <label class="form-check-label">@Html.CheckBoxFor(m => m.RememberMe) Ghi nhớ đăng nhập</label>
            <a href="@Url.Action("ForgotPassword")">Quên mật khẩu?</a>
        </div>
        <button class="btn btn-orange w-100 py-2">Đăng nhập</button>
    }
    <p class="text-center mt-4 mb-0">Chưa có tài khoản? <a href="@Url.Action("Register")"><b>Đăng ký ngay</b></a></p>
</div>