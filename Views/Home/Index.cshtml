@model ShopTheThao.ViewModels.HomeViewModel
@{
    ViewBag.Title = "Trang chủ";
    var vn = new System.Globalization.CultureInfo("vi-VN");
    var spotlightProduct = Model.NewProducts != null && Model.NewProducts.Any() ? Model.NewProducts.First() : null;

    var catImages = new System.Collections.Generic.Dictionary<string, string> {
        { "bong-da", "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?w=700&auto=format&fit=crop&q=80" },
        { "chay-bo", "https://images.unsplash.com/photo-1552674605-db6ffd4facb5?w=700&auto=format&fit=crop&q=80" },
        { "gym", "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=700&auto=format&fit=crop&q=80" },
        { "cau-long", "https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?w=700&auto=format&fit=crop&q=80" },
        { "phu-kien", "https://images.unsplash.com/photo-1556817411-31ae72fa3ea0?w=700&auto=format&fit=crop&q=80" }
    };
    var defaultCatImg = "https://images.unsplash.com/photo-1517649763962-0c623266ddc0?w=700&auto=format&fit=crop&q=80";
}
<link href="~/Content/css/home.css" rel="stylesheet" />

<div class="wrap py-3">

    <!-- 1. Split Editorial Hero (Inspired by AUREL) -->
    <section class="editorial-hero">
        <div class="editorial-hero-grid">
            <div class="editorial-hero-copy">
                <div>
                    <span class="editorial-hero-kicker">BỘ SƯU TẬP XUÂN HÈ / 2026</span>
                    <h1 class="editorial-hero-title">
                        Dấu ấn riêng.<br />
                        <em>Bản lĩnh vĩnh cửu.</em>
                    </h1>
                    <p class="editorial-hero-sub">
                        Không chỉ là một món đồ thể thao. Đây là sự khởi đầu cho hành trình chinh phục mọi giới hạn với chất liệu tuyển chọn và thiết kế vượt thời gian.
                    </p>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <a class="btn-orange" href="@Url.Action("Index", "Product")">
                            <span>Khám phá bộ sưu tập</span>
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                        <a class="btn-luxury-light" href="#philosophy">
                            Triết lý chế tác
                        </a>
                    </div>
                </div>

                <div class="editorial-hero-meta">
                    <span>01 — 04</span>
                    <span>TUYỂN CHỌN CHÍNH HÃNG • CHUẨN VẬN ĐỘNG VIÊN</span>
                </div>
            </div>

            <div class="editorial-hero-visual">
                @if (spotlightProduct != null)
                {
                    <a class="hero-glass-spotlight" href="@Url.Action("Details", "Product", new { id = spotlightProduct.Id })">
                        <small>PHIÊN BẢN TIÊU ĐIỂM</small>
                        <strong>
                            <span>@spotlightProduct.Name</span>
                            <i class="bi bi-arrow-up-right"></i>
                        </strong>
                        <span>@((spotlightProduct.SalePrice ?? spotlightProduct.Price).ToString("N0", vn)) ₫</span>
                    </a>
                }
                else
                {
                    <a class="hero-glass-spotlight" href="@Url.Action("Index", "Product")">
                        <small>PHIÊN BẢN GIỚI HẠN</small>
                        <strong>
                            <span>Pro Carbon Elite</span>
                            <i class="bi bi-arrow-up-right"></i>
                        </strong>
                        <span>Sợi dệt khí động học • Đế phản hồi lực</span>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- 2. Editorial Philosophy Statement -->
    <section class="editorial-philosophy" id="philosophy">
        <div class="editorial-philosophy-grid">
            <div class="editorial-philosophy-label">
                TRIẾT LÝ THIẾT KẾ
            </div>
            <div>
                <h2 class="philosophy-quote">
                    Đẳng cấp không cần lên tiếng.<br />
                    Chỉ cần được cảm nhận qua từng bước chạy.
                </h2>
                <p class="philosophy-desc">
                    Không chạy theo những chi tiết hào nhoáng nhất thời, mỗi sản phẩm tại SportHub là sự cân bằng tuyệt đối giữa cấu trúc công thái học chuẩn xác, vật liệu siêu nhẹ và vẻ đẹp tối giản bền vững.
                </p>
            </div>
        </div>
    </section>

    <!-- 3. High-End Product Showcase: Biểu tượng của riêng bạn -->
    <section class="sec">
        <div class="sec-head">
            <div>
                <span class="eyebrow">BỘ SƯU TẬP MỚI • TUYỂN CHỌN ĐẶC BIỆT</span>
                <h2>Biểu tượng của riêng bạn</h2>
            </div>
            <a class="sec-link-pill" href="@Url.Action("Index", "Product", new { SortBy = "newest" })">
                <span>Xem toàn bộ</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="p-grid">
            @foreach (var p in Model.NewProducts.Take(4))
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top text-muted small" style="border-color: var(--line) !important;">
            <span>Mỗi thiết kế đều được kiểm định chất lượng nghiêm ngặt trước khi trao tay.</span>
            <a href="@Url.Action("Index", "Product")" class="text-uppercase fw-semibold" style="font-size: 0.74rem; letter-spacing: 0.12em;">
                Khám phá danh mục đầy đủ <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>
    </section>

    <!-- 4. Split Craftsmanship Storytelling Section -->
    <section class="sec">
        <div class="craft-split">
            <div class="craft-split-media" role="img" aria-label="Nghệ thuật chế tác thể thao"></div>
            <div class="craft-split-body">
                <span class="eyebrow eyebrow-light">NGHỆ THUẬT CHẾ TÁC ĐỈNH CAO</span>
                <h2>
                    Thời gian tạo nên<br />
                    điều phi thường.
                </h2>
                <p>
                    Mỗi đường may chịu lực, mỗi lớp đệm đế phản hồi năng lượng tại SportHub là kết quả của hàng trăm giờ thử nghiệm thực địa cùng các vận động viên chuyên nghiệp.
                </p>
                <div class="craft-points">
                    <div>Tỉ mỉ trong từng sợi dệt khí động học</div>
                    <div>Bền bỉ qua từng mùa chinh phục</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Three Core Brand Values -->
    <section class="core-values-grid">
        <div class="core-value-card">
            <span class="core-value-number">01 / CHẤT LIỆU</span>
            <h5>Chất liệu tuyển chọn</h5>
            <p>Sợi tổng hợp thoáng khí đa chiều, cao su nguyên bản độ bám cao và đệm EVA mật độ kép giúp bảo vệ tối đa cổ chân và khớp gối.</p>
        </div>
        <div class="core-value-card">
            <span class="core-value-number">02 / KỸ THUẬT</span>
            <h5>Tinh hoa công thái học</h5>
            <p>Phom dáng được tinh chỉnh theo cấu trúc bàn chân và cơ thể người Việt, mang lại cảm giác ôm vừa vặn ngay từ lần đầu sử dụng.</p>
        </div>
        <div class="core-value-card">
            <span class="core-value-number">03 / CAM KẾT</span>
            <h5>Đồng hành dài lâu</h5>
            <p>Bảo hành keo chỉ chính hãng, hỗ trợ đổi size tận nơi trong 7 ngày và đội ngũ chuyên gia tư vấn trang bị theo từng cự ly tập luyện.</p>
        </div>
    </section>

    <!-- 6. Sport Categories Showcase -->
    <section class="sec" id="danhmuc">
        <div class="sec-head">
            <div>
                <span class="eyebrow">DANH MỤC CHUYÊN BIỆT</span>
                <h2>Bộ môn của bạn</h2>
            </div>
            <a class="sec-link-pill" href="@Url.Action("Index", "Product")">
                <span>Tất cả môn</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="cat-grid">
            @{ int catIdx = 1; }
            @foreach (var c in Model.Categories)
            {
                var slug = c.Slug ?? "";
                var img = catImages.ContainsKey(slug) ? catImages[slug] : defaultCatImg;
                <a class="cat-tile" href="@Url.Action("Index", "Product", new { CategoryId = c.Id })" style="background-image: url('@img');">
                    <span class="cat-tile-num">0@(catIdx++)</span>
                    <div class="cat-tile-content">
                        <div class="cat-tile-title">@c.Name</div>
                        <span class="cat-tile-link">Khám phá <i class="bi bi-arrow-up-right"></i></span>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- 7. Best Sellers & Seasonal Offers -->
    <section class="sec">
        <div class="sec-head">
            <div>
                <span class="eyebrow">ĐƯỢC YÊU THÍCH NHẤT</span>
                <h2>Thiết kế dẫn đầu</h2>
            </div>
            <a class="sec-link-pill" href="@Url.Action("Index", "Product", new { SortBy = "best_seller" })">
                <span>Xem thêm</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="p-grid">
            @foreach (var p in Model.BestSellers.Take(4))
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    </section>

    <!-- 8. Exclusive Membership CTA with Liquid Glass Card (SPORTHUB PRIVÉ) -->
    <section class="sec mb-5">
        <div class="prive-section">
            <div class="prive-grid">
                <div>
                    <span class="eyebrow eyebrow-light">SPORTHUB PRIVÉ</span>
                    <h2 class="editorial-heading text-white mb-3" style="font-size: clamp(2rem, 3.4vw, 2.85rem);">
                        Một thế giới riêng.<br />
                        Dành cho bạn.
                    </h2>
                    <p class="mb-4" style="color: #B8ABA0; max-width: 480px; line-height: 1.8;">
                        Chào đón những đặc quyền dành riêng cho thành viên: trải nghiệm sớm các phiên bản giới hạn, dịch vụ tư vấn trang bị 1-1 và ưu đãi 10% (mã <strong class="text-white">SPORT10</strong>) cho đơn hàng từ 500.000₫.
                    </p>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <a href="@Url.Action("Register", "Account")" class="btn-orange">
                            <span>Trở thành hội viên Privé</span>
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                        <a href="@Url.Action("Index", "Product", new { onSale = true })" class="btn-luxury-light">
                            Xem đặc quyền mùa này
                        </a>
                    </div>
                </div>

                <div class="d-flex justify-content-center justify-content-lg-end">
                    <div class="membership-glass-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold" style="letter-spacing: 0.2em; font-size: 0.8rem;">SPORTHUB</span>
                            <span style="font-size: 0.68rem; letter-spacing: 0.16em; color: rgba(255,255,255,0.65);">PRIVÉ MEMBER</span>
                        </div>

                        <div class="vip-card-monogram">S</div>

                        <div class="d-flex justify-content-between align-items-end">
                            <div>
                                <div style="font-size: 0.65rem; letter-spacing: 0.16em; color: rgba(255,255,255,0.55); text-transform: uppercase;">MÃ ĐẶC QUYỀN</div>
                                <div class="fw-semibold" style="letter-spacing: 0.14em; font-size: 0.88rem;">SPORT10 • VIP</div>
                            </div>
                            <span style="font-size: 0.72rem; letter-spacing: 0.14em; color: rgba(255,255,255,0.7);">001</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>
