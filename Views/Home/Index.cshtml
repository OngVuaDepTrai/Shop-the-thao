@model ShopTheThao.ViewModels.HomeViewModel
@{
    ViewBag.Title = "Trang chủ";
    
    // Ảnh nền chuyên nghiệp cho từng bộ môn thể thao
    var catImages = new System.Collections.Generic.Dictionary<string, string> {
        { "bong-da", "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?w=600&auto=format&fit=crop&q=80" },
        { "chay-bo", "https://images.unsplash.com/photo-1552674605-db6ffd4facb5?w=600&auto=format&fit=crop&q=80" },
        { "gym", "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=600&auto=format&fit=crop&q=80" },
        { "cau-long", "https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?w=600&auto=format&fit=crop&q=80" },
        { "phu-kien", "https://images.unsplash.com/photo-1556817411-31ae72fa3ea0?w=600&auto=format&fit=crop&q=80" }
    };
    var defaultCatImg = "https://images.unsplash.com/photo-1517649763962-0c623266ddc0?w=600&auto=format&fit=crop&q=80";
}
<link href="~/Content/css/home.css" rel="stylesheet" />

<div class="wrap py-4">

    <!-- 1. Hero Athletic Banner Slider (Thiết kế thực tế, không chi tiết ảo) -->
    <div id="heroSlider" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="0" class="active" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        
        <div class="carousel-inner">
            <!-- Slide 1: Bộ sưu tập mới -->
            <div class="carousel-item active">
                <div class="hero-slide hero-slide-1">
                    <div class="hero-content">
                        <span class="hero-tag">
                            <i class="bi bi-lightning-fill text-warning"></i> BỘ SƯU TẬP 2026
                        </span>
                        <h1>Bứt phá giới hạn.<br>Chinh phục đường chạy.</h1>
                        <p>Trang bị giày chạy bộ và trang phục thể thao chính hãng với công nghệ đệm khí phản hồi lực thế hệ mới.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a class="btn-hero-primary" href="@Url.Action("Index", "Product")">
                                <span>Mua ngay</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a class="btn-hero-secondary" href="#danhmuc">
                                Xem danh mục
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Ưu đãi đầu mùa -->
            <div class="carousel-item">
                <div class="hero-slide hero-slide-2">
                    <div class="hero-content">
                        <span class="hero-tag">
                            <i class="bi bi-tag-fill text-warning"></i> ĐẶC QUYỀN HỘI VIÊN
                        </span>
                        <h1>Giảm 10% cho đơn từ 500K.<br>Mã ưu đãi: SPORT10</h1>
                        <p>Nhập mã tại bước thanh toán để nhận ngay ưu đãi trực tiếp cho toàn bộ sản phẩm đồ tập và phụ kiện.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a class="btn-hero-primary" href="@Url.Action("Index", "Product", new { onSale = true })">
                                <span>Khám phá ưu đãi</span>
                                <i class="bi bi-percent"></i>
                            </a>
                            <a class="btn-hero-secondary" href="@Url.Action("Index", "Product")">
                                Tất cả sản phẩm
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 3: Gym & Training -->
            <div class="carousel-item">
                <div class="hero-slide hero-slide-3">
                    <div class="hero-content">
                        <span class="hero-tag">
                            <i class="bi bi-fire text-warning"></i> TRAINING & FITNESS
                        </span>
                        <h1>Sẵn sàng cho mọi hiệp đấu.<br>Thoáng mát suốt buổi tập.</h1>
                        <p>Chất liệu vải sợi Air-Mesh co giãn 4 chiều, hỗ trợ cơ bắp và thấm hút mồ hôi tối ưu.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a class="btn-hero-primary" href="@Url.Action("Index", "Product")">
                                <span>Xem sản phẩm</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Trust & Benefits Bar (Thanh cam kết tiêu chuẩn e-commerce) -->
    <div class="benefits-bar">
        <div class="benefit-card">
            <div class="benefit-icon"><i class="bi bi-shield-check"></i></div>
            <div>
                <b>100% Chính Hãng</b>
                <small>Cam kết hoàn tiền gấp 10 lần</small>
            </div>
        </div>
        <div class="benefit-card">
            <div class="benefit-icon"><i class="bi bi-truck"></i></div>
            <div>
                <b>Giao Hàng Siêu Tốc</b>
                <small>Toàn quốc trong 2 - 3 ngày</small>
            </div>
        </div>
        <div class="benefit-card">
            <div class="benefit-icon"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <b>Đổi Size Trong 7 Ngày</b>
                <small>Hỗ trợ đổi trả tận nhà miễn phí</small>
            </div>
        </div>
        <div class="benefit-card">
            <div class="benefit-icon"><i class="bi bi-headset"></i></div>
            <div>
                <b>Tư Vấn Chuyên Sâu</b>
                <small>Hotline 1900 6868 luôn sẵn sàng</small>
            </div>
        </div>
    </div>

    <!-- 3. Danh mục môn thể thao (Category Showcase Grid thực tế) -->
    <section class="sec" id="danhmuc">
        <div class="sec-head">
            <h2>Môn Thể Thao Phổ Biến</h2>
            <a href="@Url.Action("Index", "Product")">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        
        <div class="cat-grid">
            @foreach (var c in Model.Categories)
            {
                var slug = c.Slug ?? "";
                var img = catImages.ContainsKey(slug) ? catImages[slug] : defaultCatImg;
                <a class="cat-tile" href="@Url.Action("Index", "Product", new { CategoryId = c.Id })" style="background-image: url('@img');">
                    <div class="cat-tile-content">
                        <div class="cat-tile-title">@c.Name</div>
                        <span class="cat-tile-link">Khám phá <i class="bi bi-arrow-right"></i></span>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- 4. Sản phẩm mới về -->
    <section class="sec">
        <div class="sec-head">
            <h2>Sản Phẩm Mới Về</h2>
            <a href="@Url.Action("Index", "Product", new { SortBy = "newest" })">Xem thêm <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="p-grid">
            @foreach (var p in Model.NewProducts)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    </section>

    <!-- 5. Sản phẩm bán chạy nhất -->
    <section class="sec">
        <div class="sec-head">
            <h2>Bán Chạy Nhất Tuần</h2>
            <a href="@Url.Action("Index", "Product", new { SortBy = "best_seller" })">Xem thêm <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="p-grid">
            @foreach (var p in Model.BestSellers)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    </section>

    <!-- 6. Special Promo Banner (Thiết kế thanh lịch) -->
    <section class="sec">
        <div class="promo-strip d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
            <div style="position: relative; z-index: 2; max-width: 650px;">
                <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">ƯU ĐÃI ĐỘC QUYỀN</span>
                <h3 class="fw-bold text-white mb-2" style="font-size: clamp(1.5rem, 2.4vw, 2.1rem);">
                    Giảm 10% Cho Đơn Hàng Từ 500.000₫
                </h3>
                <p class="text-white-50 mb-0" style="line-height: 1.6;">
                    Áp dụng cho toàn bộ giày chạy, đồ tập gym và trang phục thể thao chính hãng. Nhập mã ưu đãi khi thanh toán.
                </p>
            </div>
            <div class="text-md-end" style="position: relative; z-index: 2;">
                <div class="promo-code-box mb-2">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>SPORT10</span>
                </div>
                <small class="text-white-50 d-block">Sao chép mã & áp dụng tại giỏ hàng</small>
            </div>
        </div>
    </section>

    <!-- 7. Đang khuyến mãi -->
    <section class="sec mb-5">
        <div class="sec-head">
            <h2>Ưu Đãi Giảm Giá</h2>
            <a href="@Url.Action("Index", "Product", new { onSale = true })">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="p-grid">
            @foreach (var p in Model.SaleProducts)
            {
                @Html.Partial("_ProductCard", p)
            }
        </div>
    </section>

</div>
