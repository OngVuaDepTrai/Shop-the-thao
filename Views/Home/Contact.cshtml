@{
    ViewBag.Title = "Liên hệ & Hệ thống Showroom";
}

<div class="wrap py-4">
    <!-- Breadcrumb -->
    <nav class="sport-breadcrumb" aria-label="breadcrumb">
        <ol>
            <li><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="active">Liên hệ</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="row g-4 align-items-end mb-4 pb-4 border-bottom" style="border-color: var(--line) !important;">
        <div class="col-lg-7">
            <span class="eyebrow">KẾT NỐI VỚI CHÚNG TÔI</span>
            <h1 class="editorial-heading mb-0" style="font-size: clamp(2rem, 3.5vw, 2.8rem);">Chúng tôi luôn lắng nghe bạn.</h1>
        </div>
        <div class="col-lg-5">
            <p class="text-muted mb-0" style="line-height: 1.8;">Cần tư vấn chọn giày, chọn size hay hỗ trợ bảo hành? Gửi lời nhắn hoặc ghé showroom trực tiếp.</p>
        </div>
    </div>

    <!-- Contact info strip -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="core-value-number mb-1">SHOWROOM</div>
            <div class="small">140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP.HCM</div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="core-value-number mb-1">HOTLINE</div>
            <a href="tel:19006868" class="small fw-semibold">1900 6868</a>
        </div>
        <div class="col-6 col-lg-3">
            <div class="core-value-number mb-1">EMAIL</div>
            <a href="mailto:hotro@sporthub.vn" class="small fw-semibold">hotro@sporthub.vn</a>
        </div>
        <div class="col-6 col-lg-3">
            <div class="core-value-number mb-1">GIỜ MỞ CỬA</div>
            <div class="small">Thứ 2 – Chủ nhật, 8:00 – 22:00</div>
        </div>
    </div>

    <!-- Main Section: Form + Map -->
    <div class="row g-5 align-items-stretch mb-5">
        <!-- Form Left -->
        <div class="col-lg-6">
            <div class="card p-4 p-md-5 border rounded-3 bg-surface h-100" style="border-color: var(--line-border) !important;">
                <span class="eyebrow">LIÊN HỆ TRỰC TUYẾN</span>
                <h3 class="editorial-heading mb-2">Gửi tin nhắn cho SportHub</h3>
                <p class="text-muted small mb-4">Điền thông tin vào mẫu bên dưới, chúng tôi sẽ phản hồi sớm nhất.</p>

                @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Họ và tên của bạn <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required 
                               value="@(User.Identity.IsAuthenticated ? ShopTheThao.Helpers.AuthHelper.FullName(User) : "")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ Email <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" placeholder="name@example.com" required 
                               value="@(User.Identity.IsAuthenticated ? User.Identity.Name : "")" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Nội dung tin nhắn <span class="text-danger">*</span></label>
                        <textarea name="message" rows="5" class="form-control" placeholder="Hãy cho chúng tôi biết bạn cần hỗ trợ điều gì..." required></textarea>
                    </div>

                    <button type="submit" class="btn-orange w-100 py-3">
                        <span>Gửi tin nhắn</span> <i class="bi bi-arrow-up-right"></i>
                    </button>
                }
            </div>
        </div>

        <!-- Map Right -->
        <div class="col-lg-6">
            <div class="card p-2 border rounded-3 bg-surface h-100 overflow-hidden" style="border-color: var(--line-border) !important; min-height: 450px; box-shadow: var(--shadow-sm);">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.0628282377317!2d106.62648417570377!3d10.80649748934416!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752be27d8b4f4d%3A0x92dcba2950430867!2zMTQwIEzDqiBUcuG7jW5nIFThuqVuLCBUw6J5IFRo4bqhbmgSwgVMOibiBQaMO6LCBI4buTIENow60gTWluaCwgVmnhu4d0IE5hbQ!5e0!3m2!1svi!2s!4v1700000000000!5m2!1svi!2s" 
                        width="100%" height="100%" style="border:0; border-radius: 12px; min-height: 420px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</div>
