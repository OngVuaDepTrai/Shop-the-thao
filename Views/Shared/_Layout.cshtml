<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - SportHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Content/css/site.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">
        <div class="wrap d-flex align-items-center gap-3 gap-lg-4">
            <a class="brand-logo" href="@Url.Action("Index","Home")"><i class="bi bi-lightning-charge-fill"></i> SportHub</a>
            <nav class="main-nav d-none d-lg-flex">
                <a href="@Url.Action("Index","Home")">Trang chủ</a>
                <a href="@Url.Action("Index","Product")">Sản phẩm</a>
                <a href="@Url.Action("Index","Product")">Khuyến mãi</a>
                <a href="@Url.Action("Contact","Home")">Liên hệ</a>
            </nav>
            <form class="nav-search d-none d-md-block" action="@Url.Action("Index","Product")" method="get">
                <i class="bi bi-search"></i><input name="q" placeholder="Tìm sản phẩm..." />
            </form>
            <div class="ms-auto d-flex align-items-center gap-2">
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="btn btn-outline-orange btn-sm" href="@Url.Action("Index","Profile")"><i class="bi bi-person"></i> @ShopTheThao.Helpers.AuthHelper.FullName(User)</a>
                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "m-0" }))
                    { @Html.AntiForgeryToken() <button class="btn btn-orange btn-sm">Đăng xuất</button> }
            }
            else
            {
                <a class="btn btn-outline-orange btn-sm" href="@Url.Action("Login","Account")">Đăng nhập</a>
                <a class="btn btn-orange btn-sm" href="@Url.Action("Register","Account")">Đăng ký</a>
            }
            </div>
        </div>
    </header>
    @if (TempData["Success"] != null && ViewBag.Title != "Hồ sơ cá nhân")
    {<div class="wrap mt-3"><div class="alert alert-orange">@TempData["Success"]</div></div>}
    @RenderBody()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>