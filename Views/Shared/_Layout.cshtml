<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - SportHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Content/css/site.css" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    @Html.Partial("_Header")

    @if (ViewBag.Title != "Hồ sơ cá nhân")
    {
        if (TempData["Success"] != null)
        {
            <div class="wrap mt-3">
                <div class="alert alert-orange alert-dismissible fade show d-flex align-items-center gap-2 mb-0" role="alert">
                    <i class="bi bi-check-circle-fill text-orange fs-5"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            </div>
        }
        if (TempData["Error"] != null)
        {
            <div class="wrap mt-3">
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            </div>
        }
        if (TempData["Warning"] != null)
        {
            <div class="wrap mt-3">
                <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-2 mb-0" role="alert">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>@TempData["Warning"]</div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            </div>
        }
    }

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    @Html.Partial("_Footer")

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/site.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
