@model ShopTheThao.Models.Product
@{
    var vn = new System.Globalization.CultureInfo("vi-VN");
    var onSale = Model.SalePrice.HasValue && Model.SalePrice.Value < Model.Price;
    var now = onSale ? Model.SalePrice.Value : Model.Price;
    var slug = Model.Category != null ? (Model.Category.Slug ?? "") : "";
    var icons = new System.Collections.Generic.Dictionary<string, string> {
        { "bong-da", "bi-dribbble" }, { "chay-bo", "bi-person-walking" }, { "gym", "bi-heart-pulse" },
        { "cau-long", "bi-feather" }, { "phu-kien", "bi-bag-heart" } };
    var ic = icons.ContainsKey(slug) ? icons[slug] : "bi-trophy-fill";
}
<a class="p-card" href="@Url.Action("Details", "Product", new { id = Model.Id })">
    <div class="p-thumb">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {<img src="@Model.ImageUrl" alt="@Model.Name" /> }
        else
        { <i class="bi @ic"></i>}
        @if (onSale)
        {<span class="p-badge">-@(100 - (int)(Model.SalePrice.Value * 100 / Model.Price))%</span>}
        <span class="p-go"><i class="bi bi-arrow-up-right"></i></span>
    </div>
    <div class="p-body">
        <small class="p-cat">@(Model.Category != null ? Model.Category.Name : "")</small>
        <h6 class="p-name">@Model.Name</h6>
        <div class="p-price">
            <b>@now.ToString("N0", vn) ₫</b>
            @if (onSale)
            {<s>@Model.Price.ToString("N0", vn) ₫</s>}
        </div>
        <small class="p-sold">Đã bán @Model.SoldCount</small>
    </div>
</a>