                    <i class="bi bi-credit-card" title="Thẻ ATM / Visa / Mastercard"></i>
                    <i class="bi bi-wallet2" title="Ví MoMo / VNPay"></i>
                    <i class="bi bi-qr-code" title="Chuyển khoản QR ngân hàng"></i>
                </div>
