<!-- Service Highlights Banner -->
<section class="py-4 bg-surface border-top border-bottom" style="border-color: var(--line-border) !important;">
    <div class="wrap">
        <div class="row g-4 text-center text-md-start">
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-orange-light text-orange" style="width: 52px; height: 52px; font-size: 1.4rem; flex-shrink: 0;">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Giao hàng siêu tốc</div>
                        <small class="text-muted">Nhận hàng trong 2-3 ngày</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-orange-light text-orange" style="width: 52px; height: 52px; font-size: 1.4rem; flex-shrink: 0;">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Đổi trả trong 7 ngày</div>
                        <small class="text-muted">Đổi size tận nơi miễn phí</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-orange-light text-orange" style="width: 52px; height: 52px; font-size: 1.4rem; flex-shrink: 0;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">100% Chính hãng</div>
                        <small class="text-muted">Đền gấp 10 lần nếu phát hiện giả</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-orange-light text-orange" style="width: 52px; height: 52px; font-size: 1.4rem; flex-shrink: 0;">
                        <i class="bi bi-headset"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Hỗ trợ 24/7</div>
                        <small class="text-muted">Hotline 1900 6868 luôn sẵn sàng</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Footer -->
<footer class="main-footer">
    <div class="wrap">
        <div class="row g-4 g-lg-5">
            <!-- Col 1: Brand & Contact Info -->
            <div class="col-lg-4 col-md-6">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-lightning-charge-fill text-orange fs-2"></i>
                    <span class="fs-4 fw-bold text-white">Sport<span class="text-orange">Hub</span></span>
                </div>
                <p class="text-white-50 mb-4" style="line-height: 1.7;">
                    SportHub là điểm đến tin cậy hàng đầu cho các tín đồ đam mê thể thao. Chuyên phân phối trang phục, giày và dụng cụ thể thao cao cấp chính hãng.
                </p>
                <div class="d-flex flex-column gap-2 text-white-50">
                    <div><i class="bi bi-geo-alt-fill text-orange me-2"></i> 140 Lê Trọng Tấn, P. Tây Thạnh, Q. Tân Phú, TP.HCM</div>
                    <div><i class="bi bi-telephone-fill text-orange me-2"></i> Hotline: <strong class="text-white">1900 6868</strong> (8:00 - 22:00)</div>
                    <div><i class="bi bi-envelope-fill text-orange me-2"></i> Email: <strong class="text-white">hotro@sporthub.vn</strong></div>
                </div>
            </div>

            <!-- Col 2: About SportHub -->
            <div class="col-lg-2 col-md-6 col-6">
                <h6 class="footer-heading">VỀ SPORTHUB</h6>
