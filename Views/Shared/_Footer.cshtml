                    <li><a href="@Url.Action("Index", "Product")">Bộ sưu tập thể thao</a></li>
                    <li><a href="@Url.Action("Contact", "Home")">Hệ thống showroom</a></li>
                    <li><a href="#">Tin tức & Sự kiện</a></li>
                    <li><a href="#">Cơ hội việc làm</a></li>
                </ul>
            </div>

            <!-- Col 3: Customer Care -->
            <div class="col-lg-3 col-md-6 col-6">
                <h6 class="footer-heading">HỖ TRỢ KHÁCH HÀNG</h6>
